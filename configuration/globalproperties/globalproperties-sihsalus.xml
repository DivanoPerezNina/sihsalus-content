<config>
    <globalProperties>
        <!-- Core OpenMRS properties (from reference application) -->
        <globalProperty>
            <property>concept.true</property>
            <value>1</value>
        </globalProperty>

        <globalProperty>
            <property>concept.false</property>
            <value>2</value>
        </globalProperty>

        <globalProperty>
            <property>visits.assignmentHandler</property>
            <value
            >org.openmrs.api.handler.ExistingVisitAssignmentHandler</value>
        </globalProperty>

        <globalProperty>
            <property>visits.allowOverlappingVisits</property>
            <value>false</value>
        </globalProperty>

        <globalProperty>
            <property>application.name</property>
            <value>SIH SALUS</value>
        </globalProperty>

        <globalProperty>
            <property>layout.name.format</property>
            <value>long</value>
        </globalProperty>

        <globalProperty>
            <property>use_patient_attribute.mothersName</property>
            <value>true</value>
        </globalProperty>

        <globalProperty>
            <property>openconceptlab.subscriptionUrl</property>
            <value
            >https://api.openconceptlab.org/orgs/SIHSALUS/sources/sihsalus/2026-07-16-02</value>
        </globalProperty>

        <!-- ENV VARIABLE: OMRS_OCL_TOKEN -->
        <globalProperty>
            <property>openconceptlab.token</property>
            <value>${OMRS_OCL_TOKEN}</value>
        </globalProperty>

        <!-- Queue Configuration -->

        <!--
        https://app.openconceptlab.org/#/orgs/SIHSALUS/sources/sihsalus/concepts/2724/ -->
        <globalProperty>
            <property>queue.serviceConceptSetName</property>
            <value>4bf3f465-ac91-44fa-9b1f-173daf0c89a0</value>
        </globalProperty>

        <!--
        https://app.openconceptlab.org/#/orgs/SIHSALUS/sources/sihsalus/concepts/2726/ -->
        <globalProperty>
            <property>queue.priorityConceptSetName</property>
            <value>d736c954-601f-4d8b-b778-6df7f3ed3767</value>
        </globalProperty>

        <!--
        https://app.openconceptlab.org/#/orgs/SIHSALUS/sources/sihsalus/concepts/2720/ -->
        <globalProperty>
            <property>queue.statusConceptSetName</property>
            <value>a10612bc-373d-44cf-8a1a-277e65f7fcf9</value>
        </globalProperty>

        <!-- This requires that the sort weight for priority concepts be maintained in order of
        least to most urgent -->
        <globalProperty>
            <property>queue.sortWeightGenerator</property>
            <value>basicPrioritySortWeightGenerator</value>
        </globalProperty>

        <globalProperty>
            <property>sihsalus.queue.visitQueueNumberAttributeUuid</property>
            <value>06a0b8c6-cbdf-4b42-9cbd-871129db8758</value>
            <description>
                UUID del tipo de atributo de visita usado para conservar el número de turno de
                cola.
            </description>
        </globalProperty>

        <globalProperty>
            <property>sihsalus.timezone</property>
            <value>America/Lima</value>
            <description>
                Zona horaria operativa de SIH SALUS para citas, visitas y colas.
            </description>
        </globalProperty>

        <globalProperty>
            <property>concept.causeOfDeath</property>
            <value>9272a14b-7260-4353-9e5b-5787b5dead9d</value>
        </globalProperty>

        <globalProperty>
            <property>attachments.allowedFileExtensions</property>
            <value>jpeg,jpg,png,pdf</value>
        </globalProperty>

        <globalProperty>
            <property>webservices.rest.maxResultsAbsolute</property>
            <value>1000</value>
        </globalProperty>

        <globalProperty>
            <property>webservices.rest.maxResultsDefault</property>
            <value>200</value>
        </globalProperty>

        <globalProperty>
            <property>fhir2.paging.maximum</property>
            <value>2000</value>
        </globalProperty>

        <globalProperty>
            <property>fhir2.paging.default</property>
            <value>10</value>
        </globalProperty>

        <!-- Internationalization Configuration -->
        <globalProperty>
            <property>locale.allowed.list</property>
            <value>en, es</value>
        </globalProperty>

        <globalProperty>
            <property>default_locale</property>
            <value>es</value>
        </globalProperty>

        <!-- Billing Configuration -->
        <globalProperty>
            <property>cashier.systemReceiptNumberGenerator</property>
            <value
            >org.openmrs.module.cashier.api.SequentialReceiptNumberGenerator</value>
            <description
            >The fully qualified class name of the component responsible for generating
                sequential receipt numbers within the cashier system. This class contains functions
                and methods tailored to efficiently generate unique receipt numbers in sequential
                order.</description>
        </globalProperty>

        <!-- Drug Order Properties -->
        <globalProperty>
            <property>order.drugDosingUnitsConceptUuid</property>
            <value>162384AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</value>
        </globalProperty>

        <globalProperty>
            <property>order.drugRoutesConceptUuid</property>
            <value>162394AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</value>
        </globalProperty>

        <globalProperty>
            <property>order.drugDispensingUnitsConceptUuid</property>
            <value>162402AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</value>
        </globalProperty>

        <globalProperty>
            <property>order.durationUnitsConceptUuid</property>
            <value>1732AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</value>
        </globalProperty>

        <globalProperty>
            <property>drugOrder.requireOutpatientQuantity</property>
            <value>true</value>
            <description>
                Exige cantidad, unidad de dispensación y renovaciones en las prescripciones
                ambulatorias.
            </description>
        </globalProperty>

        <!-- Stock Management: these values must match the frontend stock catalog contract. -->
        <globalProperty>
            <property>stockmanagement.stockSourceCodeConceptId</property>
            <value>2e1e8049-9cbe-4a2d-b1e5-8a91e5d7d97d</value>
        </globalProperty>

        <globalProperty>
            <property>stockmanagement.stockAdjustmentReasonCodeConceptId</property>
            <value>3bbfaa44-d5b8-404d-b4c1-2bf49ad8ce25</value>
        </globalProperty>

        <globalProperty>
            <property>stockmanagement.dispensingUnitsConceptId</property>
            <value>162402AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</value>
        </globalProperty>

        <globalProperty>
            <property>stockmanagement.packagingUnitsConceptId</property>
            <value>bce2b1af-98b1-48a2-98a2-3e4ffb3c79c2</value>
        </globalProperty>

        <globalProperty>
            <property>stockmanagement.stockItemCategoryConceptId</property>
            <value>6d24eb6e-b42f-4706-ab2d-ae4472161f6a</value>
        </globalProperty>

        <globalProperty>
            <property>stockmanagement.negativeStockBalanceAllowed</property>
            <value>false</value>
        </globalProperty>

        <!-- ESM Fast Data Entry Configuration -->
        <globalProperty>
            <property
            >@openmrs/esm-fast-data-entry-app.groupSessionVisitTypeUuid</property>
            <value>23939157-9af0-457b-8f6c-211eb5459311</value>
            <description
            >UUID of the visit type used by Fast Data Entry to create visits when in
                'group sessions' entry workflow</description>
        </globalProperty>

        <!-- FHIR Configuration -->
        <globalProperty>
            <property>fhir2.administeringEncounterRoleUuid</property>
            <value>a0b03050-c99b-11e0-9572-0800200c9a66</value>
        </globalProperty>

        <globalProperty>
            <property>fhir2.immunizationsEncounterTypeUuid</property>
            <value>29c02aff-9a93-46c9-bf6f-48b552fcb1fa</value>
        </globalProperty>

        <!-- Dyaku / RENHICE Interoperability Configuration -->
        <globalProperty>
            <property>sihsalusinterop.renhice.endpoint</property>
            <value>http://hapi-fhir:8080/fhir</value>
            <description>
                Endpoint URL del servidor FHIR de RENHICE (Dyaku).
                Usa el nombre del servicio Docker 'hapi-fhir' para comunicación interna.
            </description>
        </globalProperty>

        <!-- OAuth2 SSO Configuration - descomentar si se quiere usar
        <globalProperty>
            <property>oauth2login.loginWithOAuth2</property>
            <value>true</value>
        </globalProperty>

        <globalProperty>
            <property>oauth2login.redirectUriAfterLogin</property>
            <value>/openmrs/spa</value>
        </globalProperty>

        <globalProperty>
            <property>oauth2login.defaultRoles</property>
            <value>Provider</value>
        </globalProperty>

        <globalProperty>
            <property>oauth2login.createProviderAccount</property>
            <value>true</value>
        </globalProperty>

        -->
    </globalProperties>
</config>
